# The application is offline-only by default. These two settings must both be
# changed deliberately before any paid model request can be made.
LLM_MODE=offline
ALLOW_PAID_LLM=false

# Optional OpenAI integration. Leave blank in offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional Langfuse integration. Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://data_assistant:data_assistant@db:5432/data_assistant

